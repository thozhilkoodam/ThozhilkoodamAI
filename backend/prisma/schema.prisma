generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  support
  recruitment_agency
  hr_recruiter
  msme_client
  candidate
}

enum CompanyStatus {
  pending
  approved
  rejected
  suspended
}

enum JobStatus {
  draft
  submitted
  pending_review
  under_review
  changes_requested
  approved
  published
  rejected
  expired
  archived
  closed
}

enum JobPriority {
  low
  medium
  high
  urgent
}

enum ApplicationStatus {
  applied
  screening
  shortlisted
  interview
  selected
  offer
  joined
  rejected
}

enum InterviewType {
  online
  offline
}

enum InterviewStatus {
  scheduled
  completed
  cancelled
}

enum TeamRole {
  admin
  hr_manager
  recruiter
  interviewer
  viewer
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(support)
  status       String   @default("active")
  phone        String?
  photo        String?
  googleId     String?  @unique @map("google_id")
  phoneOtp     String?  @map("phone_otp")
  createdAt    DateTime @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  auditLogs            AuditLog[]
  candidateProfile     CandidateProfile?
  candidateEducation   CandidateEducation[]
  candidateExperience  CandidateExperience[]
  candidateSkills      CandidateSkill[]
  candidateDocuments   CandidateDocument[]
  candidateCertifications CandidateCertification[]
  candidateApplications CandidateApplication[]
  savedJobs            SavedJob[]
  candidateNotifs      CandidateNotification[]
  candidateMessages    CandidateMessage[]
  interviewInvitations InterviewInvitation[]
  aiResumeExtractions  AIResumeExtraction[]
  aiResumeAnalyses     AIResumeAnalysis[]
  aiJobMatches         AIJobMatch[]
  aiCandidateScreenings AICandidateScreening[]
  candidateInterviews  CandidateInterview[]
  aiInterviewPreparations AIInterviewPreparation[]
  aiInterviewEvaluations AIInterviewEvaluation[]
  jobOffers            JobOffer[]
  candidateOnboardings CandidateOnboarding[]

  @@map("users")
}



model Company {
  id                 String        @id @default(uuid())
  companyId          String        @unique @map("company_id")
  agencyName         String        @map("agency_name")
  contactPerson      String        @map("contact_person")
  position           String?
  employeeCount      String?       @map("employee_count")
  vacancyCount       String?       @map("vacancy_count")
  registrationNumber String?       @map("registration_number")
  phone              String?
  email              String        @unique
  passwordHash       String        @map("password_hash")
  category           String        @default("recruitment-agencies")
  status             CompanyStatus @default(pending)
  logo               String?
  approvedBy         String?       @map("approved_by")
  approvedDate       DateTime?     @map("approved_date")
  rejectionReason    String?       @map("rejection_reason")
  rejectedBy         String?       @map("rejected_by")
  rejectedAt         DateTime?     @map("rejected_at")
  suspendedBy        String?       @map("suspended_by")
  suspendedAt        DateTime?     @map("suspended_at")
  address            String?
  city               String?
  countryId          Int?          @map("country_id")
  stateId            Int?          @map("state_id")
  districtId         Int?          @map("district_id")
  cityId             Int?          @map("city_id")
  createdAt          DateTime      @default(now()) @map("created_at")

  documents    CompanyDocument[]
  teamMembers  TeamMember[]
  jobs         Job[]
  subscriptions Subscription[]
  payments     Payment[]
  pipelineStages PipelineStage[]
  interviews   Interview[]
  hrRecruiters HRRecruiter[]
  candidateInterviews CandidateInterview[]
  jobOffers    JobOffer[]
  candidateOnboardings CandidateOnboarding[]

  @@map("companies")
}

model CompanyDocument {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  url       String
  type      String
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_documents")
}

model TeamMember {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  email     String
  role      TeamRole
  status    String   @default("invited")
  joinedAt  DateTime @default(now()) @map("joined_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

model Job {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  title           String
  department      String?
  employmentType  String?   @map("employment_type")
  workMode        String?   @map("work_mode")
  location        String?
  countryId        Int?      @map("country_id")
  stateId          Int?      @map("state_id")
  districtId       Int?      @map("district_id")
  cityId           Int?      @map("city_id")
  experience      String?
  experienceYears  Int?      @map("experience_years")
  experienceMonths Int?      @map("experience_months")
  salaryMin       Float?    @map("salary_min")
  salaryMax       Float?    @map("salary_max")
  salaryRange     String?   @map("salary_range")
  salaryType      String?   @map("salary_type")
  salaryPeriod    String?   @map("salary_period")
  vacancyCount    Int?      @map("vacancy_count")
  noticePeriod    String?   @map("notice_period")
  description     String?
  responsibilities String?
  skills          String?
  qualifications  String?
  benefits        String?
  primarySkills   String?   @map("primary_skills")
  secondarySkills String?   @map("secondary_skills")
  mandatorySkills String?   @map("mandatory_skills")
  preferences     String?
  screeningQuestions String? @map("screening_questions")

  organizationType  String?   @map("organization_type")
  organizationName  String?   @map("organization_name")
  companyLogo       String?   @map("company_logo")
  postedBy          String?   @map("posted_by")
  postedDate        DateTime? @map("posted_date")
  applicationDeadline DateTime? @map("application_deadline")
  industry          String?
  isPublished       Boolean   @default(false) @map("is_published")

  status          JobStatus @default(draft)
  approvalStatus  String?   @map("approval_status")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectedReason  String?   @map("rejected_reason")
  requestedChanges String?  @map("requested_changes")
  submittedAt     DateTime? @map("submitted_at")
  publishedAt     DateTime? @map("published_at")
  archivedAt      DateTime? @map("archived_at")
  priority        JobPriority @default(medium)
  featured        Boolean   @default(false) @map("is_featured")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  aiJobMatches AIJobMatch[]
  aiCandidateScreenings AICandidateScreening[]
  candidateInterviews CandidateInterview[]
  aiInterviewPreparations AIInterviewPreparation[]
  aiInterviewEvaluations AIInterviewEvaluation[]
  jobOffers    JobOffer[]
  candidateOnboardings CandidateOnboarding[]

  @@index([status])
  @@index([approvalStatus])
  @@index([companyId])
  @@index([postedBy])

  @@map("jobs")
}

model Candidate {
  id            String   @id @default(uuid())
  name          String
  designation   String?
  currentCompany String? @map("current_company")
  experience    String?
  skills        String?
  location      String?
  lastActive    DateTime? @map("last_active")
  photo         String?
  gender        String?
  currentCtc    Float?   @map("current_ctc")
  expectedCtc   Float?   @map("expected_ctc")
  noticePeriod  String?  @map("notice_period")
  email         String?
  phone         String?
  resumeUrl     String?  @map("resume_url")
  createdAt     DateTime @default(now()) @map("created_at")

  applications   Application[]
  interviews     Interview[]
  pipelineStages PipelineStage[]

  @@map("candidates")
}

model Application {
  id          String             @id @default(uuid())
  jobId       String             @map("job_id")
  candidateId String             @map("candidate_id")
  status      ApplicationStatus  @default(applied)
  appliedAt   DateTime           @default(now()) @map("applied_at")

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("applications")
}

model PipelineStage {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  title       String
  orderIndex  Int      @map("order_index")
  candidateId String?  @map("candidate_id")
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company?  @relation(fields: [companyId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@map("pipeline_stages")
}

model Interview {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  candidateId   String          @map("candidate_id")
  candidateName String          @map("candidate_name")
  jobTitle      String          @map("job_title")
  recruiterId   String?         @map("recruiter_id")
  date          DateTime
  startTime     String          @map("start_time")
  endTime       String          @map("end_time")
  type          InterviewType
  status        InterviewStatus @default(scheduled)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  company   Company?     @relation(fields: [companyId], references: [id])
  candidate Candidate    @relation(fields: [candidateId], references: [id])
  recruiter HRRecruiter? @relation(fields: [recruiterId], references: [id])

  @@map("interviews")
}

model Subscription {
  id             String             @id @default(uuid())
  companyId      String             @map("company_id")
  planName       String             @map("plan_name")
  jobPosts       Int                @map("job_posts")
  candidateAccess Int               @map("candidate_access")
  teamMembers    Int                @map("team_members")
  validityMonths Int                @map("validity_months")
  price          Float
  status         SubscriptionStatus @default(active)
  startDate      DateTime           @default(now()) @map("start_date")
  endDate        DateTime           @map("end_date")
  createdAt      DateTime           @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  orderId        String?       @map("order_id")
  paymentId      String?       @map("payment_id")
  amount         Float
  currency       String        @default("INR")
  status         PaymentStatus @default(pending)
  razorpayOrderId String?      @map("razorpay_order_id")
  razorpayPaymentId String?    @map("razorpay_payment_id")
  razorpaySignature String?    @map("razorpay_signature")
  createdAt      DateTime      @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice?

  @@map("payments")
}

model Invoice {
  id        String   @id @default(uuid())
  paymentId String   @unique @map("payment_id")
  number    String
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userName  String   @map("user_name")
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum RequirementStatus {
  pending
  under_review
  quoted
  client_approved
  recruiter_assigned
  candidate_search
  interview
  offer
  joining
  completed
}

enum QuotationStatus {
  draft
  sent
  approved
  rejected
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum MeetingType {
  online
  offline
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
}

model EmailLog {
  id           String   @id @default(uuid())
  recipient    String
  subject      String
  status       String   @default("sent")
  errorMessage String?  @map("error_message")
  sentAt       DateTime @default(now()) @map("sent_at")

  @@map("email_logs")
}

model HRRecruiter {
  id               String   @id @default(uuid())
  employeeId       String   @unique @map("employee_id")
  name             String
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  email            String   @unique
  passwordHash     String   @map("password_hash")
  phone            String?
  photo            String?
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           String?
  company          String?
  branch           String?
  countryId        Int?      @map("country_id")
  stateId          Int?      @map("state_id")
  districtId       Int?      @map("district_id")
  cityId           Int?      @map("city_id")
  department       String?
  designation      String?
  reportingManager String?  @map("reporting_manager")
  hiringManager    String?  @map("hiring_manager")
  joiningDate      DateTime? @map("joining_date")
  employmentType   String?  @map("employment_type")
  experience       String?
  preferredIndustry String? @map("preferred_industry")
  preferredJobRoles String? @map("preferred_job_roles")
  preferredLocations String? @map("preferred_locations")
  languages        String?
  skills           String?
  certifications   String?
  linkedIn         String?  @map("linked_in")
  github           String?
  portfolio        String?
  username         String?  @unique
  resumeUrl        String?  @map("resume_url")
  status           String   @default("pending")
  suspensionReason String?  @map("suspension_reason")
  approvedBy       String?  @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  agencyId         String?  @map("agency_id")
  googleId         String?  @unique @map("google_id")
  phoneOtp         String?  @map("phone_otp")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  lastLogin        DateTime? @map("last_login")
  assignedJobs     Int      @default(0) @map("assigned_jobs")
  assignedCandidates Int    @default(0) @map("assigned_candidates")
  interviewsCount  Int      @default(0) @map("interviews_count")
  offersReleased   Int      @default(0) @map("offers_released")
  placements       Int      @default(0)
  conversionRate   Float?   @map("conversion_rate")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignments      RecruiterAssignment[]
  interviews       Interview[]
  agency           Company? @relation(fields: [agencyId], references: [id])

  @@index([status])
  @@index([agencyId])
  @@map("hr_recruiters")
}

model MSMEClient {
  id               String   @id @default(uuid())
  companyId        String   @unique @map("company_id")
  companyName      String   @map("company_name")
  email            String   @unique
  passwordHash     String   @map("password_hash")
  phone            String?
  logo             String?
  gst              String?
  pan              String?
  address          String?
  city             String?
  countryId        Int?      @map("country_id")
  stateId          Int?      @map("state_id")
  districtId       Int?      @map("district_id")
  cityId           Int?      @map("city_id")
  website          String?
  industry         String?
  employeeCount    String?  @map("employee_count")
  status           String   @default("pending")
  gstCert          String?  @map("gst_cert")
  panCert          String?  @map("pan_cert")
  incorporationCert String? @map("incorporation_cert")
  businessRegCert  String?  @map("business_reg_cert")
  directorAadhaar  String?  @map("director_aadhaar")
  directorPan      String?  @map("director_pan")
  aadhaarVerified  Boolean  @default(false) @map("aadhaar_verified")
  googleId         String?  @unique @map("google_id")
  phoneOtp         String?  @map("phone_otp")
  verifiedAt       DateTime? @map("verified_at")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?  @map("rejection_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  requirements     Requirement[]
  quotations       Quotation[]
  supportTickets   SupportTicket[]
  meetings         Meeting[]

  @@map("msme_clients")
}

model Requirement {
  id              String             @id @default(uuid())
  requirementId   String             @unique @map("requirement_id")
  clientId        String             @map("client_id")
  companyName     String             @map("company_name")
  department      String?
  position        String
  vacancies       Int                @map("vacancies")
  experience      String?
  education       String?
  skills          String?
  minSalary       Float?             @map("min_salary")
  maxSalary       Float?             @map("max_salary")
  hiringDeadline  DateTime?          @map("hiring_deadline")
  joiningDate     DateTime?          @map("joining_date")
  location        String?
  description     String?
  employmentType  String?            @map("employment_type")
  interviewMode   String?            @map("interview_mode")
  venue           String?
  interviewDate   DateTime?          @map("interview_date")
  interviewTime   String?            @map("interview_time")
  contactPerson   String?            @map("contact_person")
  contactPhone    String?            @map("contact_phone")
  googleMap       String?            @map("google_map")
  instructions    String?
  meetingLink     String?            @map("meeting_link")
  meetingPlatform String?            @map("meeting_platform")
  status          RequirementStatus  @default(pending)
  priority        String?            @default("medium")
  budget          Float?
  timeline        String?
  assignedAt      DateTime?          @map("assigned_at")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  client       MSMEClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trackers     RequirementTracker[]
  assignments  RecruiterAssignment[]
  quotations   Quotation[]

  @@map("requirements")
}

model RequirementTracker {
  id          String   @id @default(uuid())
  requirementId String @map("requirement_id")
  stage       String
  completed   Boolean  @default(false)
  completedAt DateTime? @map("completed_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("requirement_trackers")
}

model RecruiterAssignment {
  id            String   @id @default(uuid())
  requirementId String   @map("requirement_id")
  recruiterId   String   @map("recruiter_id")
  assignedBy    String   @map("assigned_by")
  assignedAt    DateTime @default(now()) @map("assigned_at")

  requirement Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  recruiter   HRRecruiter @relation(fields: [recruiterId], references: [id])

  @@map("recruiter_assignments")
}

model Quotation {
  id            String          @id @default(uuid())
  quotationNo   String          @unique @map("quotation_no")
  requirementId String          @map("requirement_id")
  clientId      String          @map("client_id")
  serviceCharges Float          @map("service_charges")
  placementCharges Float        @map("placement_charges")
  gstPercentage Float           @default(18) @map("gst_percentage")
  totalAmount   Float           @map("total_amount")
  terms         String?
  status        QuotationStatus @default(draft)
  pdfUrl        String?         @map("pdf_url")
  approvedAt    DateTime?       @map("approved_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  client      MSMEClient  @relation(fields: [clientId], references: [id])

  @@map("quotations")
}

model SupportTicket {
  id          String       @id @default(uuid())
  ticketNo    String       @unique @map("ticket_no")
  clientId    String       @map("client_id")
  subject     String
  message     String
  attachment  String?
  status      TicketStatus @default(open)
  adminReply  String?      @map("admin_reply")
  repliedAt   DateTime?    @map("replied_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  client MSMEClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model Meeting {
  id          String        @id @default(uuid())
  clientId    String        @map("client_id")
  date        DateTime
  time        String
  purpose     String
  type        MeetingType
  status      MeetingStatus @default(scheduled)
  link        String?
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  client MSMEClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("meetings")
}

enum ConsultantStatus {
  pending_activation
  active
  inactive
  suspended
}

model HRConsultant {
  id                String           @id @default(uuid())
  employeeId        String           @unique @map("employee_id")
  name              String
  email             String           @unique
  passwordHash      String           @map("password_hash")
  activationToken   String?          @unique @map("activation_token")
  activationExpires DateTime?        @map("activation_expires")
  phone             String?
  photo             String?
  agencyId          String?          @map("agency_id")
  agencyName        String?          @map("agency_name")
  branch            String?
  department        String?
  designation       String?
  reportingManager  String?          @map("reporting_manager")
  hiringManager     String?          @map("hiring_manager")
  experience        String?
  specialization    String?
  preferredIndustries String?        @map("preferred_industries")
  preferredJobRoles  String?         @map("preferred_job_roles")
  preferredLocations String?         @map("preferred_locations")
  languages         String?
  skills            String?
  certifications    String?
  achievements      String?
  resumeUrl         String?          @map("resume_url")
  linkedInUrl       String?          @map("linked_in_url")
  githubUrl         String?          @map("github_url")
  portfolioUrl      String?          @map("portfolio_url")
  status            ConsultantStatus @default(active)
  performanceScore  Float?           @default(0) @map("performance_score")
  googleId          String?          @unique @map("google_id")
  phoneOtp          String?          @map("phone_otp")
  twoFactorEnabled  Boolean          @default(false) @map("two_factor_enabled")
  lastLogin         DateTime?        @map("last_login")
  createdAt         DateTime         @default(now()) @map("created_at")

  assignments       ConsultantAssignment[]
  candidates        CandidateV2[]
  interviews        InterviewV2[]
  notifications     ConsultantNotification[]
  activityLogs      ConsultantActivityLog[]

  @@map("hr_consultants")
}

model ConsultantAssignment {
  id            String   @id @default(uuid())
  consultantId  String   @map("consultant_id")
  requirementId String?  @map("requirement_id")
  clientName    String?  @map("client_name")
  position      String?
  assignedBy    String?  @map("assigned_by")
  assignedAt    DateTime @default(now()) @map("assigned_at")

  consultant HRConsultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@map("consultant_assignments")
}

model CandidateV2 {
  id              String   @id @default(uuid())
  consultantId    String   @map("consultant_id")
  name            String
  email           String?
  phone           String?
  photo           String?
  designation     String?
  currentCompany  String?  @map("current_company")
  experience      String?
  skills          String?
  education       String?
  location        String?
  currentCtc      Float?   @map("current_ctc")
  expectedCtc     Float?   @map("expected_ctc")
  noticePeriod    String?  @map("notice_period")
  aiMatchScore    Float?   @default(0) @map("ai_match_score")
  resumeUrl       String?  @map("resume_url")
  documents       String?
