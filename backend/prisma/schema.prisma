  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  interview        CandidateInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("interview_responses")
}

enum AIEvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AIInterviewEvaluation {
  id                 String              @id @default(uuid())
  interviewId        String              @unique @map("interview_id")
  applicationId      String              @map("application_id")
  candidateId        String              @map("candidate_id")
  jobId              String              @map("job_id")

  status             AIEvaluationStatus  @default(PENDING)
  evaluationData     Json?               @map("evaluation_data")
  deterministicScore Float?              @map("deterministic_score")
  scoreBreakdown     Json?               @map("score_breakdown")

  model              String
  promptVersion      String              @map("prompt_version")
  evaluatorVersion   String              @map("evaluator_version")
  errorMessage       String?             @map("error_message") @db.Text

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  completedAt        DateTime?           @map("completed_at")

  interview          CandidateInterview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  application        CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate          User                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([applicationId])
  @@index([status])
  @@map("ai_interview_evaluations")
}

enum JobOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model JobOffer {
  id                 String              @id @default(uuid())
  applicationId      String              @unique @map("application_id")
  jobId              String              @map("job_id")
  candidateId        String              @map("candidate_id")
  companyId          String              @map("company_id")

  jobTitle           String              @map("job_title")
  department         String?
  workLocation       String?             @map("work_location")
  employmentType     String              @default("full_time") @map("employment_type")
  joiningDate        DateTime?           @map("joining_date")

  baseSalary         Float               @map("base_salary")
  salaryPeriod       String              @default("annual") @map("salary_period")
  currency           String              @default("INR")
  variableBonus      Float?              @default(0) @map("variable_bonus")
  benefits           String?             // JSON string array of perks & benefits

  offerLetterContent String              @db.Text @map("offer_letter_content")
  status             JobOfferStatus      @default(DRAFT)
  sentAt             DateTime?           @map("sent_at")
  expiresAt          DateTime?           @map("expires_at")
  acceptedAt         DateTime?           @map("accepted_at")
  declinedAt         DateTime?           @map("declined_at")
  declineReason      String?             @map("decline_reason")
  internalNotes      String?             @db.Text @map("internal_notes")
  aiDraftMetadata    Json?               @map("ai_draft_metadata")

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  application        CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate          User                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  onboarding         CandidateOnboarding?

  @@index([candidateId])
  @@index([companyId])
  @@index([jobId])
  @@index([status])
  @@map("job_offers")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  JOINED
  CANCELLED
}

model CandidateOnboarding {
  id                   String            @id @default(uuid())
  applicationId        String            @unique @map("application_id")
  offerId              String            @unique @map("offer_id")
  candidateId          String            @map("candidate_id")
  companyId            String            @map("company_id")
  jobId                String            @map("job_id")

  status               OnboardingStatus  @default(NOT_STARTED)
  joiningDate          DateTime?         @map("joining_date")
  checklist            Json              // array of checklist items
  completionPercentage Float             @default(0) @map("completion_percentage")
  documents            Json?             // array of uploaded onboarding document metadata
  internalNotes        String?           @db.Text @map("internal_notes")

  completedAt          DateTime?         @map("completed_at")
  joinedAt             DateTime?         @map("joined_at")
  cancelledAt          DateTime?         @map("cancelled_at")
  cancellationReason   String?           @map("cancellation_reason")

  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  application          CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offer                JobOffer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  candidate            User                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([companyId])
  @@index([jobId])
  @@index([status])
  @@map("candidate_onboardings")
}

